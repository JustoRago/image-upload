# Copy this file to .env and fill in your values.

# Server
# Session signing secret — use a long random string (e.g. `openssl rand -hex 32`)
SECRET=change-me-to-a-long-random-string
# Origin of the front-end (CORS allowlist)
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL
DBUSER=your_db_user
DBPASS=your_db_password
DBHOST=localhost
DBNAME=image_upload
# PostgreSQL port (DBPORT is preferred; PORT is accepted for backwards compatibility)
DBPORT=5432

# Default user seed (dev/test only, ignored in production).
# Defaults: asdt560 / justojose1 / asdt560@gmail.com — the credentials the test
# suite uses. Override any of them to seed with your own account:
# SEED_USERNAME=asdt560
# SEED_PASSWORD=justojose1
# SEED_EMAIL=asdt560@gmail.com